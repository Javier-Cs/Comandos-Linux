--- creacion de archivo de config
sudo nano /etc/nginx/sites-available/nottyn_Config


--- contenido

server {
    listen 80;
    server_name nottyn.legumfrutsa.com;

    location / {
        proxy_pass http://127.0.0.1:0000;       --- puerto

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

--- habitar
sudo ln -s /etc/nginx/sites-available/nottyn_Config /etc/nginx/sites-enabled/

--- despues
sudo nginx -t


--- reiniciar
sudo systemctl restart nginx